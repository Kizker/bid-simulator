{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ],
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
    }
  ],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/rooms/[id]",
      "regex": "^/api/rooms/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/rooms/(?<nxtPid>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_global-error",
      "regex": "^/_global\\-error(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_global\\-error(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/admin",
      "regex": "^/admin(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin(?:/)?$"
    },
    {
      "page": "/api/admin/auth",
      "regex": "^/api/admin/auth(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/admin/auth(?:/)?$"
    },
    {
      "page": "/api/auth/login",
      "regex": "^/api/auth/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/auth/login(?:/)?$"
    },
    {
      "page": "/api/auth/register",
      "regex": "^/api/auth/register(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/auth/register(?:/)?$"
    },
    {
      "page": "/api/auth/users",
      "regex": "^/api/auth/users(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/auth/users(?:/)?$"
    },
    {
      "page": "/api/bids",
      "regex": "^/api/bids(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/bids(?:/)?$"
    },
    {
      "page": "/api/bots",
      "regex": "^/api/bots(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/bots(?:/)?$"
    },
    {
      "page": "/api/rooms",
      "regex": "^/api/rooms(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/rooms(?:/)?$"
    },
    {
      "page": "/api/rooms/import-json",
      "regex": "^/api/rooms/import\\-json(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/rooms/import\\-json(?:/)?$"
    },
    {
      "page": "/api/rooms/reset",
      "regex": "^/api/rooms/reset(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/rooms/reset(?:/)?$"
    },
    {
      "page": "/api/schedule",
      "regex": "^/api/schedule(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/schedule(?:/)?$"
    },
    {
      "page": "/api/server-time",
      "regex": "^/api/server\\-time(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/server\\-time(?:/)?$"
    },
    {
      "page": "/api/users",
      "regex": "^/api/users(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/users(?:/)?$"
    },
    {
      "page": "/favicon.ico",
      "regex": "^/favicon\\.ico(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/favicon\\.ico(?:/)?$"
    },
    {
      "page": "/manifest.webmanifest",
      "regex": "^/manifest\\.webmanifest(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/manifest\\.webmanifest(?:/)?$"
    },
    {
      "page": "/robots.txt",
      "regex": "^/robots\\.txt(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/robots\\.txt(?:/)?$"
    },
    {
      "page": "/simulator",
      "regex": "^/simulator(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/simulator(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments",
    "clientParamParsing": false,
    "dynamicRSCPrerender": false
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}