# Environment variables for BidPulse Live Auction Simulator
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# Database Configuration (PostgreSQL)
# Format: postgres://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgres://bid_user:bid_secure_pass123@localhost:5432/bid_simulator

# In-Memory Cache & Real-Time Socket.IO Clustering (Redis)
# Format: redis://[:password]@<host>:<port>
REDIS_URL=redis://:redis_secure_pass123@localhost:6379

# Admin Security Credentials
NEXT_PUBLIC_ADMIN_USER=admin
ADMIN_PASSWORD=admin123
